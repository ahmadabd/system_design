# Support Service Environment Configuration
PORT=8007
ENVIRONMENT=production
SERVICE_NAME=support-service

# OpenRouter LLM Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024

# Qdrant Vector Store Configuration
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION_NAME=ecommerce_support_knowledge_base
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5

# Observability & Infrastructure
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
REDIS_URL=redis://:sys_design_secure_cache_pass_2026@redis:6379
KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# Downstream Microservices (for Tool Execution in later modules)
ORDER_SERVICE_URL=http://order-service:8003
PRODUCT_SERVICE_URL=http://product-service:8002
USER_SERVICE_URL=http://user-service:8001
